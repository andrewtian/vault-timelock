{
  "after": null,
  "volatile": [
    "error.message"
  ],
  "name": "jobs-create-400",
  "covers": "POST /jobs with an unknown key → 400 job.unknown-key",
  "request": {
    "method": "POST",
    "path": "/jobs",
    "headers": {
      "host": "{{host}}",
      "authorization": "Bearer {{token}}",
      "content-type": "application/json"
    },
    "body": {
      "format": "vt-job/1",
      "network": "local",
      "name": "eth drain to the null address",
      "message": "A synthetic vt fixture message.\nIt has two lines.\n",
      "chains": {
        "eth": {
          "mode": "drain",
          "publishMode": "eth.calldata.null",
          "feeStrategy": "passive",
          "distinctCopies": true,
          "keyAddress": "0x8739Eb87B3d11f221Df63454F8D229a1A4F4049C",
          "budgetUsd": 10,
          "maxTipGwei": 3,
          "clawbackTo": null
        }
      },
      "autoArm": true
    }
  },
  "response": {
    "status": 400,
    "headers": {
      "content-type": "application/json; charset=utf-8"
    },
    "body": {
      "error": {
        "guard": "job.unknown-key",
        "message": "(any text that never echoes input)"
      }
    }
  }
}
