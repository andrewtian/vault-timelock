{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://vault-timelock.invalid/schemas/vt-job-1.schema.json",
  "title": "vt-job/1 (JobInput)",
  "description": "Structural rules only; the validator (normalizeJob) adds EIP-55 / base58 checks, 2-decimal budgets, the clawback rules, key-like and IP-like refusals, reserved modes (and the reserved Arweave copy) and network binding. Publish modes: vt-publish/3. Generated by packages/core/contract/gen-fixtures.ts.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "network",
    "name",
    "chains"
  ],
  "properties": {
    "format": {
      "const": "vt-job/1"
    },
    "network": {
      "enum": [
        "local",
        "testnet",
        "mainnet"
      ]
    },
    "name": {
      "type": "string",
      "pattern": "^[\\x20-\\x7e]{1,64}$"
    },
    "message": {
      "type": "string",
      "minLength": 1
    },
    "messageFile": {
      "type": "string",
      "minLength": 1,
      "description": "vt only: a path relative to the job file; never posted to the API (job.message-file)"
    },
    "messageSha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "messageBytes": {
      "type": "integer",
      "minimum": 1,
      "maximum": 16777216
    },
    "arweaveCopy": {
      "type": "boolean",
      "description": "contracts/publish.ts ARWEAVE_COPY (CC-1); optional, false = absent; true is reserved and refused by the validator (job.publish-mode-unavailable)"
    },
    "textKind": {
      "enum": [
        "plain",
        "timelocked"
      ],
      "description": "CC-7; optional, default (and absent) plain; timelocked is reserved and refused by the validator (job.publish-mode-unavailable) until E6/W7; not part of the stored JobDef"
    },
    "chains": {
      "type": "object",
      "additionalProperties": false,
      "minProperties": 1,
      "properties": {
        "eth": {
          "$ref": "#/$defs/ethChain"
        },
        "sol": {
          "$ref": "#/$defs/solChain"
        },
        "btc": {
          "$ref": "#/$defs/btcChain"
        }
      }
    }
  },
  "oneOf": [
    {
      "required": [
        "message"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "messageFile"
            ]
          },
          {
            "required": [
              "messageSha256"
            ]
          },
          {
            "required": [
              "messageBytes"
            ]
          }
        ]
      }
    },
    {
      "required": [
        "messageFile"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "message"
            ]
          },
          {
            "required": [
              "messageSha256"
            ]
          },
          {
            "required": [
              "messageBytes"
            ]
          }
        ]
      }
    },
    {
      "required": [
        "messageSha256",
        "messageBytes"
      ],
      "not": {
        "anyOf": [
          {
            "required": [
              "message"
            ]
          },
          {
            "required": [
              "messageFile"
            ]
          }
        ]
      }
    }
  ],
  "$defs": {
    "mode": {
      "oneOf": [
        {
          "const": "drain"
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "copies"
          ],
          "properties": {
            "copies": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000
            }
          }
        }
      ]
    },
    "ethChain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "distinctCopies",
        "keyAddress",
        "budgetUsd",
        "clawbackTo"
      ],
      "properties": {
        "mode": {
          "$ref": "#/$defs/mode"
        },
        "feeStrategy": {
          "enum": [
            "passive",
            "economy",
            "prompt"
          ],
          "description": "default: passive for drain, economy for copies"
        },
        "distinctCopies": {
          "type": "boolean"
        },
        "budgetUsd": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000,
          "description": "at most 2 decimals (checked by the validator, job.budget)"
        },
        "publishMode": {
          "enum": [
            "eth.calldata.null",
            "eth.calldata.self",
            "eth.sstore2",
            "arweave.turbo"
          ],
          "description": "contracts/publish.ts; default DEFAULT_PUBLISH_MODE; reserved modes pass the schema and are refused by the validator (job.publish-mode-unavailable)"
        },
        "keyAddress": {
          "type": "string",
          "pattern": "^0x[0-9a-fA-F]{40}$",
          "description": "EIP-55 checksummed (job.address)"
        },
        "maxTipGwei": {
          "type": "number",
          "minimum": 0.1,
          "maximum": 100
        },
        "clawbackTo": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^0x[0-9a-fA-F]{40}$"
            }
          ],
          "description": "PF-S fix round 1 (N-6): optional (null) in a stored job and off mainnet, but REQUIRED (an address) when a mainnet job is created (job.clawback-required); on mainnet the API refuses a claw-back to any other address"
        }
      }
    },
    "solChain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "distinctCopies",
        "keyAddress",
        "budgetUsd",
        "clawbackTo"
      ],
      "properties": {
        "mode": {
          "$ref": "#/$defs/mode"
        },
        "feeStrategy": {
          "enum": [
            "passive",
            "economy",
            "prompt"
          ],
          "description": "default: passive for drain, economy for copies"
        },
        "distinctCopies": {
          "type": "boolean"
        },
        "budgetUsd": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000,
          "description": "at most 2 decimals (checked by the validator, job.budget)"
        },
        "publishMode": {
          "enum": [
            "sol.memo",
            "sol.arweave-anchor",
            "sol.account",
            "sol.noop",
            "arweave.turbo"
          ],
          "description": "contracts/publish.ts; default DEFAULT_PUBLISH_MODE; reserved modes pass the schema and are refused by the validator (job.publish-mode-unavailable)"
        },
        "keyAddress": {
          "type": "string",
          "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$",
          "description": "canonical base58 of 32 bytes (job.address)"
        },
        "maxCuPrice": {
          "type": "integer",
          "minimum": 0,
          "maximum": 2000000
        },
        "clawbackTo": {
          "oneOf": [
            {
              "type": "null"
            },
            {
              "type": "string",
              "pattern": "^[1-9A-HJ-NP-Za-km-z]{32,44}$"
            }
          ],
          "description": "PF-S fix round 1 (N-6): optional (null) in a stored job and off mainnet, but REQUIRED (an address) when a mainnet job is created (job.clawback-required); on mainnet the API refuses a claw-back to any other address"
        }
      }
    },
    "btcChain": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "distinctCopies",
        "keyAddress",
        "budgetUsd",
        "clawbackTo"
      ],
      "properties": {
        "mode": {
          "$ref": "#/$defs/mode"
        },
        "feeStrategy": {
          "enum": [
            "passive",
            "economy",
            "prompt"
          ],
          "description": "default: passive for drain, economy for copies"
        },
        "distinctCopies": {
          "type": "boolean"
        },
        "budgetUsd": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 1000,
          "description": "at most 2 decimals (checked by the validator, job.budget)"
        },
        "publishMode": {
          "enum": [
            "btc.inscription"
          ],
          "description": "contracts/publish.ts; default DEFAULT_PUBLISH_MODE; reserved modes pass the schema and are refused by the validator (job.publish-mode-unavailable)"
        },
        "keyAddress": {
          "type": "string",
          "pattern": "^bcrt1q[02-9ac-hj-np-z]{38}$",
          "description": "a lower-case bech32 p2wpkh address of the local (regtest) network (job.address)"
        },
        "maxFeeRateSatVb": {
          "type": "integer",
          "minimum": 1,
          "maximum": 500,
          "description": "CC-12: the highest fee rate (sat/vB) the lane pays (job.fee-rate). CC-14: optional here (stored jobs keep the 500 sat/vB fallback) but REQUIRED at creation for btc chains (job.btc-fee-ceiling)"
        },
        "clawbackTo": {
          "type": "null",
          "description": "there is no btc claw-back (job.clawback)"
        }
      }
    }
  }
}
